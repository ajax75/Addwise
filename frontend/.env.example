# Copy to .env and fill in from https://dashboard.emailjs.com
# .env is gitignored, so these must ALSO be set in the Vercel project's
# Environment Variables (and as GitHub Actions secrets for the Pages build).
# All four are public by design — EmailJS embeds them in the client bundle.
# The account's PRIVATE key / access token must NEVER be added here.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
REACT_APP_EMAILJS_TO_EMAIL=
